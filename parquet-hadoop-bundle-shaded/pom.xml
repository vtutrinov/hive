<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.hive</groupId>
    <artifactId>hive</artifactId>
    <version>4.2.1</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>hive-parquet-hadoop-bundle-shaded</artifactId>
  <packaging>jar</packaging>
  <name>Hive Parquet Hadoop Bundle Shaded</name>
  <description>
    Repackaged parquet-hadoop-bundle with its internal jackson upgraded to a non-vulnerable version
    (jackson 2.18.1 -> ${jackson.version}, CVE-2026-54513/54512 and the jackson-core finding).

    parquet-hadoop-bundle ${parquet.version} bundles jackson relocated under
    shaded.parquet.com.fasterxml.jackson. The first parquet releases whose jackson is outside the
    vulnerable ranges are 1.17.1+ / 1.18.x, a three-minor jump of the library Hive's Parquet
    readers and writers are built on. Instead we strip the stale jackson copy and relocate a
    current 2.18.x into the exact same package, so parquet's own bytecode links against it
    unchanged - the same approach as hive-htrace-core-shaded.
  </description>
  <properties>
    <hive.path.to.root>..</hive.path.to.root>
  </properties>
  <!--
    All four are <optional>true</optional> for the same reasons as in hive-htrace-core-shaded: they
    are shaded *into* this jar, so they must not leak to consumers transitively (that would put the
    original bundle, with its jackson 2.18.1, straight back on the classpath), and 'provided' would
    make the shade plugin's default artifactSet skip them and produce an empty jar.
  -->
  <dependencies>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-hadoop-bundle</artifactId>
      <version>${parquet.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>shade-parquet-hadoop-bundle</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <promoteTransitiveDependencies>false</promoteTransitiveDependencies>
              <artifactSet>
                <includes>
                  <include>org.apache.parquet:parquet-hadoop-bundle</include>
                  <include>com.fasterxml.jackson.core:jackson-databind</include>
                  <include>com.fasterxml.jackson.core:jackson-core</include>
                  <include>com.fasterxml.jackson.core:jackson-annotations</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>org.apache.parquet:parquet-hadoop-bundle</artifact>
                  <excludes>
                    <!-- The stale jackson 2.18.1 copy, its maven metadata (what scanners read)
                         and its service registrations. -->
                    <exclude>shaded/parquet/com/fasterxml/**</exclude>
                    <exclude>META-INF/maven/com.fasterxml.jackson.core/**</exclude>
                    <exclude>META-INF/services/com.fasterxml.jackson.*</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <!-- Neither the original bundle nor this jar is marked Multi-Release, so the
                         JVM never loads these entries; see hive-htrace-core-shaded. -->
                    <exclude>META-INF/versions/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>shaded.parquet.com.fasterxml.jackson</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
