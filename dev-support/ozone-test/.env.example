# Copy to .env and tweak as needed; docker compose picks it up automatically.
COMPOSE_PROJECT_NAME=ozone-test

# Hive version (matches root pom.xml hive.version)
HIVE_VERSION=4.2.1

# Hadoop version: 3.4.1 (what Hive 4.2.1 builds against)
HADOOP_VERSION=3.4.1

# Ozone server image (apache/ozone:<tag>). 1.4.1 is conservative.
OZONE_VERSION=1.4.1

# Ozone hadoop3 client jar version. NOTE: 1.4.1 client uses legacy
# com.google.protobuf.ServiceException (protobuf-java 2.5.0 API), which was
# REMOVED in Hadoop 3.4.x. Use 2.0.0+ when HADOOP_VERSION>=3.4 -- it links
# against modern protobuf. Wire protocol is backward-compatible so a 2.x
# client talks to a 1.4.x server fine.
OZONE_FS_HADOOP3_VERSION=1.4.1
# Suggested override for HADOOP_VERSION=3.4.x: OZONE_FS_HADOOP3_VERSION=2.0.0

# Postgres
POSTGRES_VERSION=14
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepass
POSTGRES_DB=metastore_db

# Phase 2: surgical jackson/netty swap in /opt/hadoop/common/lib (set =1 to enable)
SWAP_HADOOP_LIBS=0
JACKSON_VERSION=2.17.0
NETTY_VERSION=4.1.128.Final

# Image tag the build.sh produces and compose consumes
HMS_IMAGE=hms-ozone-test:cve-bumped
