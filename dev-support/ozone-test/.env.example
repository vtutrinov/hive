# Copy to .env and tweak as needed; docker compose picks it up automatically.
COMPOSE_PROJECT_NAME=ozone-test

# Hive version (matches root pom.xml hive.version)
HIVE_VERSION=4.0.0

# Hadoop version: 3.3.6 baseline, 3.4.1 for Phase 3 upgrade attempt
HADOOP_VERSION=3.3.6

# Ozone version (apache/ozone:<tag>); 1.4.1 is conservative + Hadoop 3.3.x client
OZONE_VERSION=1.4.1
OZONE_FS_HADOOP3_VERSION=1.4.1

# Postgres
POSTGRES_VERSION=14
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepass
POSTGRES_DB=metastore_db

# Phase 2: surgical jackson/netty swap in /opt/hadoop/common/lib (set =1 to enable)
SWAP_HADOOP_LIBS=0
JACKSON_VERSION=2.17.0
NETTY_VERSION=4.1.128.Final

# Image tag the build.sh produces and compose consumes
HMS_IMAGE=hms-ozone-test:cve-bumped
